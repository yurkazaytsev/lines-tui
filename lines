#!/usr/bin/env bash
# lines — Classic 9x9 Color Lines TUI in bare bash.
set -uo pipefail

ROOT="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck disable=SC1091
source "$ROOT/lib/state.sh"
# shellcheck disable=SC1091
source "$ROOT/lib/spawn.sh"
# shellcheck disable=SC1091
source "$ROOT/lib/path.sh"
# shellcheck disable=SC1091
source "$ROOT/lib/clear.sh"
# shellcheck disable=SC1091
source "$ROOT/lib/render.sh"
# shellcheck disable=SC1091
source "$ROOT/lib/input.sh"
# shellcheck disable=SC1091
source "$ROOT/lib/main.sh"

usage() {
  cat <<'EOF'
Usage: ./lines [--seed N] [--moves src:dst,...] [--dump] [--ascii] [--shapes] [--no-color] [--help]
  No args            interactive game: arrows move cursor, space selects
                     (or column a-i + row 1-9 in either order, no Enter;
                     Esc cancels, q=quits, n=new)
  --seed N           deterministic RNG for testing
  --moves a1:b2,...  headless: apply moves, print dump (implies --dump)
  --dump             print board as text, no TUI (with --seed for repro)
  --ascii            force ASCII glyphs (O / .)
  --shapes           distinct shape per color (playable without color;
                     env LINES_SHAPES=1)
  --no-color         emit no ANSI color escapes (env LINES_NO_COLOR=1
                     or standard NO_COLOR)
EOF
}

SEED_ARG=""
MOVES=""
DUMP=0
while (( $# > 0 )); do
  case $1 in
    --seed) SEED_ARG=${2:-}; shift 2;;
    --seed=*) SEED_ARG=${1#--seed=}; shift;;
    --moves) MOVES=${2:-}; shift 2;;
    --moves=*) MOVES=${1#--moves=}; shift;;
    --dump) DUMP=1; shift;;
    --ascii) LINES_ASCII=1; export LINES_ASCII; shift;;
    --shapes) LINES_SHAPES=1; export LINES_SHAPES; shift;;
    --no-color) LINES_NO_COLOR=1; export LINES_NO_COLOR; shift;;
    -h|--help) usage; exit 0;;
    *) printf 'unknown arg: %s\n' "$1" >&2; usage >&2; exit 2;;
  esac
done

if [[ -n "$SEED_ARG" ]]; then
  [[ $SEED_ARG =~ ^[0-9]+$ ]] || { printf 'bad --seed: %s\n' "$SEED_ARG" >&2; exit 2; }
  SEED=$SEED_ARG
fi
if [[ -n "${LINES_ASCII:-}" ]]; then ASCII_MODE=1; fi
if [[ -n "${LINES_SHAPES:-}" ]]; then SHAPES_MODE=1; fi
if [[ -n "${LINES_NO_COLOR:-}" || -n "${NO_COLOR+set}" ]]; then NO_COLOR_MODE=1; fi
# No color support detected (dumb terminal or < 8 colors): fall back to
# shapes without color so the game stays playable. Explicit flags win —
# this only fires when neither mode was requested.
if (( ! SHAPES_MODE && ! NO_COLOR_MODE )) && [[ -t 1 ]]; then
  if [[ "${TERM:-dumb}" == "dumb" ]]; then
    SHAPES_MODE=1; NO_COLOR_MODE=1
  else
    _ncolors=$(tput colors 2>/dev/null || printf '0')
    if ! [[ "$_ncolors" =~ ^[0-9]+$ ]] || (( _ncolors < 8 )); then
      SHAPES_MODE=1; NO_COLOR_MODE=1
    fi
    unset _ncolors
  fi
fi

cleanup() {
  term_cleanup
}
trap cleanup EXIT INT TERM
trap 'NEED_REDRAW=1' WINCH

init_board

if [[ -n "$MOVES" ]]; then DUMP=1; fi

if (( DUMP )) || [[ -n "$MOVES" ]]; then
  if [[ -n "$MOVES" ]]; then run_headless "$MOVES" || exit 1; fi
  dump_board
  exit 0
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  printf 'no TTY: use --dump/--moves for headless mode\n' >&2
  dump_board
  exit 0
fi

term_setup
game_interactive
